# PostgreSQL + RabbitMQ development configuration — şablon; gerçek secret içermez.
#
# Kullanım:
#   1. Bu dosyayı .env olarak kopyalayın:  copy .env.example .env
#   2. Değerleri doldurun (POSTGRES_PASSWORD ve RABBITMQ_PASSWORD zorunlu).
#   3. .env dosyası version control DIŞINDA tutulur (bkz. repo root .gitignore).
#
# Uygulama bağlantısı için .NET standart env var (process ortamında):
#   ConnectionStrings__WmsDatabase = "Host=localhost;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>"
#   RabbitMQ__Host = "localhost"
#   RabbitMQ__Port = "5672"
#   RabbitMQ__Username = "<RABBITMQ_USER>"
#   RabbitMQ__Password = "<RABBITMQ_PASSWORD>"

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

GRAFANA_USER=
GRAFANA_PASSWORD=
